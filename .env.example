# ==============================================================
# VARIABLES DE ENTORNO — Weather Pro
# Copiá este archivo como ".env" y completá los valores reales
# NUNCA subas el archivo ".env" real a git (está en .gitignore)
# ==============================================================

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False

# --- BigQuery ---
GOOGLE_APPLICATION_CREDENTIALS=credenciales/bigquery-credentials.json
BIGQUERY_PROJECT_ID=proyecto-bi-488218
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# --- webhooks n8n ---
N8N_BASE_URL=https://n8n-production-2651.up.railway.app
N8N_WEBHOOK_NAVAL=https://n8n-production-2651.up.railway.app/webhook/Naval_BI
N8N_WEBHOOK_AGRO=https://n8n-production-2651.up.railway.app/webhook/Agro_BI
N8N_WEBHOOK_AEREO=https://n8n-production-2651.up.railway.app/webhook/Aereo_BI
N8N_WEBHOOK_ENERGIA=https://n8n-production-2651.up.railway.app/webhook/Energia_BI
# Secreto compartido entre Django y n8n. Generá uno con: python -c "import secrets; print(secrets.token_hex(32))"
# Configurá la MISMA clave en:
#   - .env local / Render: N8N_WEBHOOK_SECRET
#   - Railway → servicio n8n → Variables (entorno del contenedor), NO el tab "Variables" dentro de n8n
#     (ese tab pide plan pago; el Code node lee process.env.N8N_WEBHOOK_SECRET)
#   - En Railway también: N8N_BLOCK_ENV_ACCESS_IN_NODE=false  (permite leer process.env en nodos Code)
# Después reimportá chatbot_tuclima.json y devorador_reportes.json
N8N_WEBHOOK_SECRET=cambia-esto-por-un-token-aleatorio-largo

# --- Alertas proactivas (n8n llama a Django) ---
N8N_ALERTAS_SECRET=cambia-esto-por-un-token-aleatorio-largo

# ==============================================================
# HISTÓRICO CLIMÁTICO (Fase 2 de "Estadística Climática") — n8n + BigQuery
# 1) N8N_SNAPSHOT_SECRET: protege /api/n8n/ubicaciones/ (n8n → Django, cada hora)
# 2) N8N_HISTORICO_WEBHOOK_URL: Webhook de n8n que consulta BigQuery
#    "hoy vs. promedio semanas pasadas" (Django → n8n, bajo demanda)
# 3) N8N_HISTORICO_SECRET: secreto que Django envía a ese webhook
# Configurá los mismos valores del lado de n8n (Environment Variables).
# ==============================================================
N8N_SNAPSHOT_SECRET=cambia-esto-por-un-token-aleatorio-largo
N8N_HISTORICO_WEBHOOK_URL=https://n8n-production-2651.up.railway.app/webhook/historico-clima
N8N_HISTORICO_SECRET=cambia-esto-por-un-token-aleatorio-largo

# --- Sitio (URL pública para callbacks de pago) ---
SITE_URL=https://tuclima.com.ar
# En Render: seteá SITE_URL al dominio propio (no el .onrender.com).
# Si omitís SITE_URL se usa RENDER_EXTERNAL_URL automáticamente.

# Google Search Console (opcional): pegá el content= del meta de verificación
# GOOGLE_SITE_VERIFICATION=AbCdEf123...
GOOGLE_SITE_VERIFICATION=

# ==============================================================
# PAYPAL
# Para PRUEBAS     → MODE=sandbox + credenciales de sandbox
# Para PRODUCCIÓN  → MODE=live    + credenciales live
#
# Cómo obtener credenciales LIVE:
#   1. Ir a https://developer.paypal.com/dashboard/
#   2. Apps & Credentials → pestaña "Live" (NO "Sandbox")
#   3. Crear o seleccionar una app Live
#   4. Copiar Client ID y Secret de la sección "Live"
# ==============================================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=reemplazar_con_client_id_de_sandbox_o_live
PAYPAL_CLIENT_SECRET=reemplazar_con_secret_de_sandbox_o_live

# ==============================================================
# LEMON SQUEEZY
# LEMONSQUEEZY_STORE_SLUG: slug de la tienda (ej: "tuclima-mundial")
#   lo ves en la URL del checkout: tuclima-mundial.lemonsqueezy.com
# LEMONSQUEEZY_STORE_ID:  ID numérico de la tienda
#   LS → Settings → Store → en la URL: app.lemonsqueezy.com/stores/892240 → 892240
# LEMONSQUEEZY_API_KEY:   API key de LS (app.lemonsqueezy.com/settings/api → + Add key)
# LEMONSQUEEZY_WEBHOOK_SECRET: lo seteás en LS → Settings → Webhooks
# ==============================================================
LEMONSQUEEZY_STORE_SLUG=tuclima-mundial
LEMONSQUEEZY_STORE_ID=reemplazar_con_id_numerico
LEMONSQUEEZY_API_KEY=reemplazar_con_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=whsec_reemplazar_con_el_secreto_del_webhook

# ==============================================================
# MERCADOPAGO
# Para PRUEBAS     → usar Access Token TEST-...
# Para PRODUCCIÓN  → usar Access Token APP_USR-...
#
# Cómo obtener:
#   1. https://www.mercadopago.com.ar/developers/panel
#   2. Tu aplicación → Credenciales de producción
#   3. Copiar "Access Token"
# ==============================================================
MP_ACCESS_TOKEN=TEST-reemplazar-con-access-token-real

# Moneda oficial de cobro: USD (Lemon Squeezy, Mercado Pago, PayPal).
# ARS_POR_USD quedó obsoleto para la UI; las transferencias CVU usan el equivalente del día.
# ARS_POR_USD=1000

# ==============================================================
# EMAIL (Gmail SMTP)
# Requiere "Contraseña de aplicación" (NO la contraseña normal):
#   https://myaccount.google.com/apppasswords
# ==============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_16_caracteres
DEFAULT_FROM_EMAIL=Weather Pro <tucorreo@gmail.com>

# ==============================================================
# CHECKLIST PARA IR A PRODUCCION (pagos)
# [ ] SITE_URL = URL HTTPS publica de Render (sin path)
# [ ] LEMONSQUEEZY_API_KEY / STORE_ID / WEBHOOK_SECRET configurados
# [ ] Webhook LS -> {SITE_URL}/ls-webhook/  evento order_created
# [ ] Variants LS en USD y con los IDs de PLANES_TOKENS
# [ ] MP_ACCESS_TOKEN = APP_USR-... (produccion)
# [ ] EMAIL_HOST_USER + EMAIL_HOST_PASSWORD (avisos transferencia)
# [ ] DEBUG=False
# [ ] python manage.py verificar_pagos
# [ ] python manage.py verificar_pagos --remoto
# [ ] Smoke test: 1 pago LS + 1 pago MP + 1 transferencia
# ==============================================================

# ==============================================================
# GOOGLE ADSENSE (landing — sección Partners & anuncios)
# 1) https://www.google.com/adsense/ → crear cuenta
# 2) Agregar sitio (dominio de producción) y esperar aprobación
# 3) Crear 3 unidades Display → copiar data-ad-slot
# 4) Completar variables y poner ADSENSE_ENABLED=true en Render
# ADSENSE_CLIENT=ca-pub-6917571231301347
# ADSENSE_SLOT_A=4234611639
# ADSENSE_SLOT_B=2897479230
# ADSENSE_SLOT_C=7510727841
# ADSENSE_ENABLED=true
# ==============================================================

# ==============================================================
# WEGLOT (traductor ES → EN)
# Preparado en base.html. Apagado por defecto para no gastar cuota.
# Cuando contrates el plan:
#   1) https://dashboard.weglot.com/ → Project settings → API key
#   2) Languages: Original = Spanish, Destination = English
#   3) Add domains: tuclima.com.ar y tuclima-mundial.onrender.com
#   4) En Render:
# WEGLOT_API_KEY=wg_169c193b22e7a117be85a2f56113ab415
# WEGLOT_ENABLED=true
# ==============================================================
WEGLOT_API_KEY=wg_169c193b22e7a117be85a2f56113ab415
WEGLOT_ENABLED=false
